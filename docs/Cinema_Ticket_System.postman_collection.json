		{
			"name": "2. Autentikasi (Auth)",
			"item": [
				{
					"name": "Login Admin (Simpan adminToken)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var data = pm.response.json();",
									"if (data.access_token) {",
									"    pm.collectionVariables.set('adminToken', data.access_token);",
									"    console.log('adminToken tersimpan:', data.access_token);",
									"}",
									"pm.test('Status code 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Token access_token tersedia', function () {",
									"    pm.expect(data.access_token).to.be.a('string');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Masuk sebagai Administrator sistem"
					},
					"response": []
				},
